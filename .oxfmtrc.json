{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "sortPackageJson": false,
  "svelte": {},
  "ignorePatterns": [
    ".svelte-kit",
    ".turbo",
    ".agents",
    ".output",
    ".wxt",
    ".scenebook",
    "build",
    "coverage",
    "dist",
    "node_modules",
    "playwright-report",
    "test-results",
    "bun.lock",
    "tools/oxlint/anti-slop",
    "examples/**/scenebook-dist",
    "examples/**/*-dist"
  ]
}
