{
  "name": "@scenebook/extension",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Privacy-first browser recorder for Scenebook",
  "type": "module",
  "scripts": {
    "build": "bun run icons && wxt build",
    "check": "wxt prepare && tsc --noEmit",
    "clean": "rm -rf .output .wxt",
    "dev": "wxt",
    "icons": "bun scripts/generate-icons.ts",
    "test": "vitest run",
    "test:e2e": "bun run --cwd ../studio build && bun run build && bun e2e/extension.e2e.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@scenebook/schema": "workspace:*",
    "@types/chrome": "0.2.5",
    "sharp": "0.35.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wxt": "0.21.3"
  }
}
