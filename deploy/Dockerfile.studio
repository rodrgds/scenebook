FROM oven/bun:1.3.3@sha256:fbf8e67e9d3b806c86be7a2f2e9bae801f2d9212a21db4dcf8cc9889f5a3c9c4 AS build
WORKDIR /app

COPY package.json bun.lock bunfig.toml tsconfig.json ./
COPY packages ./packages
COPY apps ./apps
COPY examples ./examples
COPY deploy ./deploy

RUN bun install --frozen-lockfile --ignore-scripts \
  && bun run --cwd packages/schema build \
  && bun run --cwd packages/viewer build \
  && bun run --cwd apps/studio build

FROM nginx:1.30.3-alpine3.23@sha256:0d3b80406a13a767339fbe2f41406d6c7da727ab89cf8fae399e81f780f814d1
COPY deploy/nginx-studio.conf /etc/nginx/nginx.conf
COPY --from=build /app/apps/studio/build /usr/share/nginx/html
RUN chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/run
USER nginx
EXPOSE 8080
