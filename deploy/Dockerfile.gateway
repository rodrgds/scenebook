FROM oven/bun:1.3.3@sha256:fbf8e67e9d3b806c86be7a2f2e9bae801f2d9212a21db4dcf8cc9889f5a3c9c4 AS build
WORKDIR /app

COPY package.json bun.lock bunfig.toml tsconfig.json ./
COPY packages ./packages
COPY apps ./apps
COPY examples ./examples

RUN bun install --frozen-lockfile --ignore-scripts \
  && bun run --cwd packages/schema build \
  && bun run --cwd packages/core build \
  && bun run --cwd packages/diff build \
  && bun run --cwd packages/privacy build \
  && bun run --cwd packages/policy build \
  && bun run --cwd packages/server build \
  && bun run --cwd packages/gateway build \
  && bun run --cwd apps/gateway build

FROM oven/bun:1.3.3@sha256:fbf8e67e9d3b806c86be7a2f2e9bae801f2d9212a21db4dcf8cc9889f5a3c9c4 AS production-dependencies
WORKDIR /app

COPY package.json bun.lock bunfig.toml tsconfig.json ./
COPY packages ./packages
COPY apps ./apps
COPY examples ./examples

RUN bun install --production --frozen-lockfile --ignore-scripts --filter @scenebook/publication-service \
  && test -e apps/gateway/node_modules/@hono/node-server \
  && test -e apps/gateway/node_modules/@scenebook/gateway \
  && test -e packages/gateway/node_modules/@scenebook/server \
  && test -e packages/server/node_modules/yaml \
  && test ! -e apps/gateway/node_modules/typescript \
  && test ! -e apps/gateway/node_modules/vitest

FROM node:22.23.1-alpine3.24@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS runtime
ENV NODE_ENV=production
WORKDIR /app

COPY --from=production-dependencies --chown=node:node /app/node_modules ./node_modules
COPY --from=production-dependencies --chown=node:node /app/apps/gateway/node_modules ./apps/gateway/node_modules
COPY --from=production-dependencies --chown=node:node /app/packages/schema/node_modules ./packages/schema/node_modules
COPY --from=production-dependencies --chown=node:node /app/packages/core/node_modules ./packages/core/node_modules
COPY --from=production-dependencies --chown=node:node /app/packages/diff/node_modules ./packages/diff/node_modules
COPY --from=production-dependencies --chown=node:node /app/packages/privacy/node_modules ./packages/privacy/node_modules
COPY --from=production-dependencies --chown=node:node /app/packages/policy/node_modules ./packages/policy/node_modules
COPY --from=production-dependencies --chown=node:node /app/packages/server/node_modules ./packages/server/node_modules
COPY --from=production-dependencies --chown=node:node /app/packages/gateway/node_modules ./packages/gateway/node_modules
COPY --from=build --chown=node:node /app/packages/schema/package.json ./packages/schema/package.json
COPY --from=build --chown=node:node /app/packages/schema/dist ./packages/schema/dist
COPY --from=build --chown=node:node /app/packages/core/package.json ./packages/core/package.json
COPY --from=build --chown=node:node /app/packages/core/dist ./packages/core/dist
COPY --from=build --chown=node:node /app/packages/diff/package.json ./packages/diff/package.json
COPY --from=build --chown=node:node /app/packages/diff/dist ./packages/diff/dist
COPY --from=build --chown=node:node /app/packages/privacy/package.json ./packages/privacy/package.json
COPY --from=build --chown=node:node /app/packages/privacy/dist ./packages/privacy/dist
COPY --from=build --chown=node:node /app/packages/policy/package.json ./packages/policy/package.json
COPY --from=build --chown=node:node /app/packages/policy/dist ./packages/policy/dist
COPY --from=build --chown=node:node /app/packages/server/package.json ./packages/server/package.json
COPY --from=build --chown=node:node /app/packages/server/dist ./packages/server/dist
COPY --from=build --chown=node:node /app/packages/gateway/package.json ./packages/gateway/package.json
COPY --from=build --chown=node:node /app/packages/gateway/dist ./packages/gateway/dist
COPY --from=build --chown=node:node /app/apps/gateway/package.json ./apps/gateway/package.json
COPY --from=build --chown=node:node /app/apps/gateway/dist ./apps/gateway/dist

USER node
EXPOSE 4320
CMD ["node", "--enable-source-maps", "apps/gateway/dist/index.js"]
