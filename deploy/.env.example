SCENEBOOK_POSTGRES_PASSWORD=replace-with-a-long-random-password
SCENEBOOK_DATABASE_URL=postgresql://scenebook:replace-with-url-encoded-password@postgres:5432/scenebook
# URL-safe password for the Compose-created, SELECT-only publication gateway role.
SCENEBOOK_GATEWAY_POSTGRES_PASSWORD=replace-with-an-independent-url-safe-password
SCENEBOOK_MINIO_ROOT_USER=scenebook-minio
SCENEBOOK_MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
SCENEBOOK_S3_ACCESS_KEY_ID=scenebook-cloud
SCENEBOOK_S3_SECRET_ACCESS_KEY=replace-with-an-independent-long-random-password
SCENEBOOK_GATEWAY_S3_ACCESS_KEY_ID=scenebook-gateway
SCENEBOOK_GATEWAY_S3_SECRET_ACCESS_KEY=replace-with-an-independent-read-only-s3-password
# Delete-only final-object identity. Do not grant Get, List, Put, or staging access.
SCENEBOOK_S3_FINAL_DELETE_ACCESS_KEY_ID=scenebook-final-delete
SCENEBOOK_S3_FINAL_DELETE_SECRET_ACCESS_KEY=replace-with-an-independent-delete-only-s3-password
SCENEBOOK_PUBLIC_URL=https://control.scenebook.example.com
# Must be a distinct origin. This is the only service that serves active publication members.
SCENEBOOK_PUBLICATION_URL=https://stories.scenebook.example.com
SCENEBOOK_ADMIN_TOKEN=replace-with-at-least-32-random-characters
SCENEBOOK_UPLOAD_TOKEN_SECRET=replace-with-at-least-32-random-characters
# Control-plane-only HMAC key for opaque personal API-token digests. It never reaches the gateway.
SCENEBOOK_IDENTITY_TOKEN_SECRET=replace-with-an-independent-32-character-secret
# Base64-encoded DER Ed25519 keys. Keep PKCS#8 private key on the control plane; the gateway gets only SPKI public key.
SCENEBOOK_IDENTITY_SIGNING_PRIVATE_KEY=replace-with-base64-pkcs8-ed25519-private-key
SCENEBOOK_IDENTITY_VERIFICATION_PUBLIC_KEY=replace-with-base64-spki-ed25519-public-key
# JSON array of at most three SPKI public keys accepted during staged rotation.
SCENEBOOK_IDENTITY_PREVIOUS_VERIFICATION_PUBLIC_KEYS_JSON=[]
# Signs short-lived HttpOnly publication sessions; never reuse the identity-token secret.
SCENEBOOK_GATEWAY_SESSION_SECRET=replace-with-an-independent-32-character-gateway-secret
# Authenticates one-time handoff consumption between the gateway and control plane.
SCENEBOOK_GATEWAY_EXCHANGE_SECRET=replace-with-an-independent-32-character-exchange-secret
SCENEBOOK_PUBLICATION_LOGIN_TTL_SECONDS=60
SCENEBOOK_GATEWAY_EXCHANGE_TIMEOUT_MS=5000
SCENEBOOK_GATEWAY_SESSION_TTL_SECONDS=28800
SCENEBOOK_GATEWAY_MAX_JSON_BYTES=16384
# Extraction is verified before response bytes are sent and bounded by this value and /tmp tmpfs.
SCENEBOOK_GATEWAY_MAX_MEMBER_BYTES=402653184
SCENEBOOK_GATEWAY_MAX_CACHE_BYTES=536870912
SCENEBOOK_GATEWAY_MAX_RESPONSES=3
# Dedicated external verification-runner credential secret. Never reuse another secret.
SCENEBOOK_RUNNER_TOKEN_SECRET=replace-with-an-independent-32-character-runner-secret
SCENEBOOK_ANALYTICS_HASH_SECRET=replace-with-at-least-32-random-characters
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
SCENEBOOK_CTA_ENCRYPTION_KEY=replace-with-a-base64url-encoded-32-byte-key
SCENEBOOK_GITHUB_OIDC_AUDIENCE=scenebook
# Optional GitHub App source integration. Leave both ID and key blank to disable it.
# Install the App only on intended repositories with Metadata read, Checks read/write,
# Contents read/write, Pull requests read/write, and Issues read/write when review issues are used.
SCENEBOOK_GITHUB_APP_ID=
# The GitHub-issued unencrypted PEM key; Compose accepts literal newlines or escaped \n.
SCENEBOOK_GITHUB_APP_PRIVATE_KEY=
# github.com is fixed to this API origin. An enterprise origin must also appear in the allowlist.
SCENEBOOK_GITHUB_APP_API_URL=https://api.github.com
SCENEBOOK_GITHUB_APP_ALLOWED_API_ORIGINS=
SCENEBOOK_GITHUB_APP_TIMEOUT_MS=15000
# Renewable source-change lease. Remote writes stop immediately if exact-lease renewal is lost.
SCENEBOOK_GITHUB_CHANGE_LEASE_SECONDS=120
SCENEBOOK_SESSION_TTL_SECONDS=28800
SCENEBOOK_API_TOKEN_MAX_TTL_SECONDS=7776000
SCENEBOOK_SHARE_LINK_MAX_TTL_SECONDS=604800
# Durable scheduled verification coordination. Execution stays on customer-owned runners.
SCENEBOOK_SCHEDULER_INTERVAL_MS=5000
SCENEBOOK_SCHEDULER_BATCH_SIZE=100
SCENEBOOK_RUNNER_LEASE_SECONDS=120
# Optional managed custom-domain ingress. Set all three values or leave all three blank.
# The routing target is the public CNAME target shown to customers. The provisioner owns real
# certificate and CDN/ingress operations and must implement the signed reconciliation contract.
SCENEBOOK_CUSTOM_DOMAIN_ROUTING_TARGET=
SCENEBOOK_CUSTOM_DOMAIN_PROVISIONER_URL=
SCENEBOOK_CUSTOM_DOMAIN_PROVISIONER_SECRET=
SCENEBOOK_CUSTOM_DOMAIN_PROVISIONER_TIMEOUT_MS=10000
# JSON array of {id,url,secret,timeoutMs}; HTTPS and public DNS are enforced.
SCENEBOOK_WEBHOOKS_JSON=[]
# HTTP protection. The aggregate budget applies across every operation for one client.
SCENEBOOK_RATE_WINDOW_MS=60000
SCENEBOOK_RATE_REQUESTS=120
SCENEBOOK_RATE_AGGREGATE_REQUESTS=300
# Request and artifact limits (bytes unless otherwise stated).
SCENEBOOK_MAX_JSON_BYTES=524288
SCENEBOOK_MAX_OBJECT_BYTES=262144000
SCENEBOOK_MAX_UPLOAD_OBJECTS=512
SCENEBOOK_MAX_UPLOAD_BYTES=2147483648
SCENEBOOK_MAX_ACTIVE_UPLOADS_TENANT=32
SCENEBOOK_MAX_ACTIVE_UPLOADS_GLOBAL=2048
SCENEBOOK_MAX_ACTIVE_UPLOAD_BYTES_TENANT=8589934592
SCENEBOOK_MAX_ACTIVE_UPLOAD_BYTES_GLOBAL=274877906944
SCENEBOOK_MAX_CONCURRENT_UPLOADS_TENANT=4
SCENEBOOK_MAX_CONCURRENT_UPLOADS_GLOBAL=64
SCENEBOOK_MAX_CONCURRENT_UPLOAD_BYTES_TENANT=536870912
SCENEBOOK_MAX_CONCURRENT_UPLOAD_BYTES_GLOBAL=8589934592
# Expired upload reclamation is claim-based, retry-safe, and bounded by this batch size.
SCENEBOOK_UPLOAD_GC_INTERVAL_MS=60000
SCENEBOOK_UPLOAD_GC_BATCH_SIZE=100
SCENEBOOK_UPLOAD_GC_CLAIM_TTL_SECONDS=300
# Final evidence lifecycle. Diagnostics expire sooner; approved Baselines and every Release remain protected.
SCENEBOOK_EVIDENCE_RETENTION_ENABLED=true
SCENEBOOK_EVIDENCE_STANDARD_RETENTION_GRACE_SECONDS=7776000
SCENEBOOK_EVIDENCE_DIAGNOSTIC_RETENTION_GRACE_SECONDS=604800
SCENEBOOK_EVIDENCE_RETENTION_INTERVAL_MS=3600000
SCENEBOOK_EVIDENCE_RETENTION_BATCH_SIZE=50
SCENEBOOK_EVIDENCE_RETENTION_CLAIM_TTL_SECONDS=300
# Portable export hard bounds; an export fails instead of truncating.
SCENEBOOK_WORKSPACE_EXPORT_MAX_RECORDS=100000
SCENEBOOK_WORKSPACE_EXPORT_MAX_ASSETS=10000
SCENEBOOK_WORKSPACE_EXPORT_MAX_ASSET_BYTES=4294967296
SCENEBOOK_WORKSPACE_EXPORT_MAX_METADATA_BYTES=67108864
SCENEBOOK_WORKSPACE_EXPORT_MAX_TOTAL_BYTES=4294967295
SCENEBOOK_CLOUD_PORT=4310
SCENEBOOK_GATEWAY_PORT=4320
SCENEBOOK_STUDIO_PORT=8080
SCENEBOOK_STATIC_PORT=8081
