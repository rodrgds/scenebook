{
  "name": "scenebook",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "description": "Local-first product-story studio with Playwright freshness checks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodrgds/scenebook.git"
  },
  "homepage": "https://github.com/rodrgds/scenebook#readme",
  "bugs": {
    "url": "https://github.com/rodrgds/scenebook/issues"
  },
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check && tsc -p scripts/tsconfig.json",
    "changeset": "changeset",
    "dev": "turbo run dev --filter=@scenebook/studio",
    "example:seed": "bun scripts/build-example-scene.ts",
    "example:test": "bun run --cwd examples/acme-product test:replay",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:artifacts": "bun scripts/verify-release.ts",
    "release:metadata:check": "bun scripts/sync-release-metadata.ts --check",
    "release:metadata:write": "bun scripts/sync-release-metadata.ts --write",
    "release:publish": "bun scripts/publish-release.ts",
    "release:verify": "bun run format:check && bun run check && bun run test && bun run build && bun run release:artifacts",
    "release:version": "changeset version && bun install --lockfile-only && bun run release:metadata:write",
    "test": "turbo run test && vitest run scripts",
    "test:integration:backend": "bun run --cwd packages/playwright test:integration:backend",
    "test:coverage": "turbo run test:coverage",
    "clean": "turbo run clean && rm -rf .turbo coverage"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@playwright/test": "1.61.1",
    "@types/bun": "1.3.14",
    "@vitest/coverage-v8": "4.1.10",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "turbo": "2.10.7",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "cookie": "0.7.2",
    "esbuild": "0.28.1",
    "shell-quote": "1.10.0",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
