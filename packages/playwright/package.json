{
  "name": "@scenebook/playwright",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Playwright fixtures, scene API, reporter, and importer for Scenebook",
  "type": "module",
  "source": "./src/index.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "import": "./dist/reporter.js",
      "default": "./dist/reporter.js"
    },
    "./importer": {
      "types": "./dist/importer.d.ts",
      "import": "./dist/importer.js",
      "default": "./dist/importer.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration:backend": "vitest run --config vitest.backend.config.ts",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@playwright/test": "1.61.1",
    "@scenebook/adapters": "workspace:*",
    "@scenebook/core": "workspace:*",
    "@scenebook/diff": "workspace:*",
    "@scenebook/privacy": "workspace:*",
    "@scenebook/schema": "workspace:*",
    "@babel/parser": "8.0.4",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1091.0",
    "@scenebook/gateway": "workspace:*",
    "@scenebook/server": "workspace:*",
    "@types/node": "26.1.1",
    "fflate": "0.8.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodrgds/scenebook.git",
    "directory": "packages/playwright"
  },
  "homepage": "https://github.com/rodrgds/scenebook#readme",
  "bugs": {
    "url": "https://github.com/rodrgds/scenebook/issues"
  }
}
