{
  "name": "@scenebook/compiler",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Deterministic compiler and export adapters for portable Scenebook scenes",
  "type": "module",
  "source": "./src/index.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./formats": {
      "types": "./dist/formats.d.ts",
      "import": "./dist/formats.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@scenebook/core": "workspace:*",
    "@scenebook/privacy": "workspace:*",
    "@scenebook/schema": "workspace:*",
    "@scenebook/viewer": "workspace:*",
    "esbuild": "0.28.1",
    "fflate": "0.8.3",
    "pdf-lib": "1.17.1",
    "sharp": "0.35.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.2",
    "happy-dom": "20.11.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodrgds/scenebook.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/rodrgds/scenebook#readme",
  "bugs": {
    "url": "https://github.com/rodrgds/scenebook/issues"
  }
}
