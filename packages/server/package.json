{
  "name": "@scenebook/server",
  "version": "0.1.0",
  "description": "Self-hosted Scenebook control plane and collaboration service",
  "type": "module",
  "source": "./src/index.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "migrations",
    "tsconfig.json",
    "tsconfig.build.json",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "import": "./dist/migrate.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "migrate": "node dist/migrate.js",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1091.0",
    "@mdx-js/mdx": "3.1.1",
    "@scenebook/core": "workspace:*",
    "@scenebook/diff": "workspace:*",
    "@scenebook/policy": "workspace:*",
    "@scenebook/privacy": "workspace:*",
    "@scenebook/schema": "workspace:*",
    "esbuild": "0.28.1",
    "fflate": "0.8.3",
    "hono": "4.12.31",
    "jose": "6.2.3",
    "pg": "8.22.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodrgds/scenebook.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/rodrgds/scenebook#readme",
  "bugs": {
    "url": "https://github.com/rodrgds/scenebook/issues"
  }
}
